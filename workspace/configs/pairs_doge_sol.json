{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "trading_mode": "spot", "dry_run": true,
  "max_open_trades": 2, "stake_currency": "USDT", "stake_amount": 100,
  "timeframe": "1h", "dry_run_wallet": 1000, "fee": 0.001,
  "cancel_open_orders_on_exit": true, "unfilledtimeout": {"entry": 15, "exit": 15},
  "exchange": {
    "name": "gate", "key": "", "secret": "",
    "pair_whitelist": ["DOGE/USDT"],
    "pair_blacklist": [],
    "ccxt_config": {"timeout": 60000, "urls": {"api": {"public": "https://api.gateio.ws", "private": "https://api.gateio.ws"}}}
  },
  "pairlists": [{"method": "StaticPairList", "allow_inactive": true}],
  "freqai": {"enabled": false, "purge_old_models": 2, "train_period_days": 45, "backtest_period_days": 15,
    "live_retrain_hours": 0, "identifier": "pairs", "feature_parameters": {"include_timeframes": ["1h"],
    "include_corr_pairlist": ["DOGE/USDT", "SOL/USDT"], "label_period_candles": 12, "include_shifted_candles": 2,
    "DI_threshold": 0.9, "weight_factor": 0.85, "principal_component_analysis": false,
    "use_SVM_to_remove_outliers": false, "indicator_periods_candles": [12, 24, 48], "plot_feature_importances": 0},
    "data_split_parameters": {"test_size": 0.3, "random_state": 7}, "model_training_parameters": {}},
  "datadir": "user_data/data", "dataformat_ohlcv": "feather",
  "entry_pricing": {"price_side": "other", "use_order_book": false, "order_book_top": 1},
  "exit_pricing": {"price_side": "other", "use_order_book": false, "order_book_top": 1}
}
