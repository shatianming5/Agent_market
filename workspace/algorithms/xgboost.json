{
  "_doc": "XGBoost 梯度提升 — 正则化更强，适合防过拟合",
  "enabled": false,
  "name": "xgboost",
  "params": {
    "objective": "reg:squarederror",
    "eval_metric": "rmse",
    "learning_rate": 0.05,
    "max_depth": 6,
    "subsample": 0.8,
    "colsample_bytree": 0.8,
    "n_estimators": 200,
    "min_child_weight": 5,
    "reg_alpha": 0.1,
    "reg_lambda": 1.0,
    "seed": 42
  },
  "tuning_hints": {
    "learning_rate": {"range": [0.01, 0.1]},
    "max_depth": {"range": [3, 10]},
    "n_estimators": {"range": [100, 1000]},
    "min_child_weight": {"range": [1, 20], "note": "越大越保守"}
  }
}
