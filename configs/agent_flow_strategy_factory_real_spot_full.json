{
  "experiment": {
    "experiment_id": "strategy-factory-real-spot-full",
    "owner": "shatianming",
    "hypothesis": "A real factor-memory-guided intraday breakout full run on gate spot data should produce control-plane memory, reusable strategy cards, and replay evidence in one end-to-end flow.",
    "budget": {
      "micro_feature": {
        "cpu_minutes": 10
      },
      "factor_compile": {
        "cpu_minutes": 3
      },
      "factor_eval": {
        "cpu_minutes": 10
      },
      "strategy_miner": {
        "llm_budget_usd": 60,
        "backtest_cpu_minutes": 120
      },
      "report": {
        "cpu_minutes": 3
      }
    }
  },
  "micro_feature": {
    "config": "user_data/config_freqai_gate_spot_core_alpha.json",
    "timeframe": "5m",
    "pairs": [
      "BTC/USDT",
      "ETH/USDT",
      "SOL/USDT"
    ],
    "timerange": "20260310-20260329"
  },
  "factor_compile": {
    "spec": {
      "name": "real_full_breakout_range_vol",
      "version": "1.0",
      "hypothesis": "Intraday breakout expansion factor combining candle range and abnormal volume, intended for trend-following and breakout strategy generation.",
      "expr": {
        "op": "mul",
        "args": [
          {
            "op": "zscore",
            "args": [
              {
                "op": "var",
                "args": [
                  "range_pct"
                ]
              },
              24
            ]
          },
          {
            "op": "tanh",
            "args": [
              {
                "op": "zscore",
                "args": [
                  {
                    "op": "var",
                    "args": [
                      "vol_z_24"
                    ]
                  },
                  24
                ]
              }
            ]
          }
        ]
      },
      "meta": {
        "timeframe": "5m",
        "universe": [
          "BTC/USDT",
          "ETH/USDT",
          "SOL/USDT"
        ],
        "data_sources": [
          "ohlcv_micro_features"
        ]
      }
    }
  },
  "factor_eval": {
    "enabled": true,
    "rows": 8192,
    "seed": 7
  },
  "strategy_miner": {
    "provider": "opencode",
    "model": "github-copilot/gpt-5-mini",
    "freqtrade_config": "user_data/config_freqai_gate_spot_core_alpha.json",
    "timerange": "20260310-20260324",
    "selection_timerange": "20260310-20260324",
    "holdout_timerange": "20260325-20260329",
    "train_timerange": "20260228-20260309",
    "benchmark_suite": "benchmark_pack/default",
    "candidates_per_iteration": 4,
    "max_iterations": 12,
    "max_turns": 20,
    "max_retries": 3,
    "stale_timeout": 180.0,
    "repair_attempts": 4,
    "max_parallel_candidates": 2,
    "max_parallel_roles": 1,
    "enable_quick_funnel": true,
    "quick_backtest_pairs": [
      "BTC/USDT",
      "ETH/USDT",
      "SOL/USDT"
    ],
    "quick_backtest_timeout": 120,
    "backtest_timeout": 420,
    "candidate_types": [
      "rule",
      "ml"
    ],
    "search_families": [
      "rule/breakout",
      "rule/trend-following",
      "rule/trend-pullback",
      "ml/lightgbm"
    ],
    "factor_retrieval_top_n": 5,
    "strategy_retrieval_top_n": 5,
    "max_strategy_timeframe": "1h",
    "allowed_informative_timeframes": [
      "15m",
      "1h"
    ],
    "min_trades": 8,
    "max_abs_drawdown": 80.0,
    "max_drawdown_pct": 18.0,
    "min_winrate": 0.42,
    "min_profit_factor": 1.0,
    "min_profit_pct": 0.0,
    "min_positive_days_ratio": 0.45,
    "min_return_over_drawdown": 0.35,
    "min_pair_profit_pct": -2.0,
    "target_trades": 80,
    "min_acceptable_trades": 25,
    "quick_min_trades": 4,
    "quick_min_profit_factor": 0.7,
    "quick_min_profit_pct": -2.0,
    "quick_max_drawdown_pct": 50.0,
    "hyperopt_enabled": true,
    "hyperopt_epochs": 60,
    "hyperopt_spaces": [
      "buy",
      "sell",
      "roi",
      "stoploss"
    ],
    "hyperopt_loss": "SharpeHyperOptLoss",
    "hyperopt_jobs": 8,
    "hyperopt_min_trades": 8,
    "walkforward_enabled": true,
    "walkforward_folds": 4,
    "walkforward_train_ratio": 0.6,
    "strategy_profile": {
      "roi_target_min_pct": 0.8,
      "roi_target_max_pct": 3.0,
      "stoploss_min_pct": 1.0,
      "stoploss_max_pct": 3.5,
      "preferred_patterns": [
        "5m breakout continuation with 1h trend confirmation",
        "5m pullback into intraday trend with 15m and 1h structure filter",
        "trend-following or breakout structures that can ride intraday moves without demanding hundreds of trades"
      ],
      "avoid_patterns": [
        "ultra-tight scalping that only works through huge trade count",
        "slow mean-reversion that fights strong trends",
        "setups that only survive on one coin and collapse on the other two"
      ]
    }
  },
  "report": {}
}
