{
  "budget": {
    "provider": "openai_compatible",
    "model": "gpt-5.2",
    "base_url": "http://127.0.0.1:4141/v1",
    "multiagent_enabled": true,
    "multiagent_refine_rounds": 1,
    "candidates_per_iteration": 6,
    "max_iterations": 200,
    "max_turns": 30,
    "max_retries": 3,
    "stale_timeout": 180.0,
    "repair_attempts": 5,
    "max_parallel_candidates": 6,
    "max_parallel_roles": 1
  },
  "backtest": {
    "freqtrade_config": "user_data/config_freqai_gate_futures_l1l2_alpha.json",
    "timerange": "20260312-20260328",
    "selection_timerange": "20260312-20260328",
    "holdout_timerange": "20260329-20260403",
    "train_timerange": "20260228-20260311",
    "backtest_timeout": 420,
    "enable_quick_funnel": true,
    "quick_backtest_pairs": ["ADA/USDT:USDT", "AVAX/USDT:USDT", "ARB/USDT:USDT"],
    "quick_backtest_timeout": 120,
    "max_strategy_timeframe": "1h",
    "allowed_informative_timeframes": ["15m", "1h"]
  },
  "model_mining": {
    "candidate_types": ["rule", "ml", "dl", "rl"],
    "enable_dl": true,
    "enable_rl": true,
    "train_timerange": "20260228-20260311",
    "model_training_pairs": [
      "ADA/USDT",
      "AVAX/USDT",
      "DOT/USDT",
      "LINK/USDT",
      "NEAR/USDT",
      "ARB/USDT",
      "OP/USDT",
      "SUI/USDT",
      "APT/USDT"
    ],
    "rl_total_timesteps": 25000
  },
  "search_space": {
    "search_families": [
      "rule/trend-following",
      "rule/breakout",
      "rule/pair-relative",
      "rule/mean-reversion",
      "ml/lightgbm",
      "ml/xgboost",
      "dl/pytorch_mlp",
      "rl/ppo"
    ],
    "family_weight_schedule": [
      {
        "iteration_lte": 24,
        "weights": {
          "rule/trend-following": 2.4,
          "rule/breakout": 2.5,
          "rule/pair-relative": 1.9,
          "rule/mean-reversion": 0.7,
          "ml/lightgbm": 2.2,
          "ml/xgboost": 1.2,
          "dl/pytorch_mlp": 0.15,
          "rl/ppo": 0.1
        }
      },
      {
        "iteration_gte": 25,
        "iteration_lte": 79,
        "weights": {
          "rule/trend-following": 2.0,
          "rule/breakout": 2.1,
          "rule/pair-relative": 1.8,
          "rule/mean-reversion": 0.9,
          "ml/lightgbm": 1.9,
          "ml/xgboost": 1.15,
          "dl/pytorch_mlp": 0.55,
          "rl/ppo": 0.45
        }
      }
    ]
  },
  "tools": {
    "tool_allowlist": ["file", "bash"],
    "bash_allow": true,
    "bash_timeout": 60,
    "bash_allowlist": [
      "ls ",
      "find ",
      "cat ",
      "head ",
      "tail ",
      "sed ",
      "grep ",
      "python ",
      "python3 ",
      "freqtrade "
    ]
  },
  "evaluation": {
    "min_trades": 6,
    "max_abs_drawdown": 80.0,
    "max_drawdown_pct": 24.0,
    "min_winrate": 0.40,
    "min_profit_factor": 1.0,
    "min_profit_pct": 0.0,
    "min_positive_days_ratio": 0.40,
    "min_return_over_drawdown": 0.35,
    "min_pair_profit_pct": -5.0,
    "target_trades": 100,
    "min_acceptable_trades": 30,
    "objective_weights": {
      "sharpe": 0.15,
      "sortino": 0.10,
      "profit_factor": 0.16,
      "calmar": 0.05,
      "profit_pct": 0.29,
      "winrate": 0.05,
      "return_over_drawdown": 0.20
    },
    "hyperopt_enabled": true,
    "hyperopt_epochs": 80,
    "hyperopt_spaces": ["buy", "sell", "roi", "stoploss"],
    "hyperopt_loss": "SharpeHyperOptLoss",
    "hyperopt_jobs": 12,
    "hyperopt_min_trades": 10,
    "walkforward_enabled": true,
    "walkforward_folds": 4,
    "walkforward_train_ratio": 0.6,
    "benchmark_suite": "benchmark_pack/default",
    "discovery_quick_min_trades": 4,
    "discovery_quick_min_profit_factor": 0.72,
    "discovery_quick_min_profit_pct": -1.8,
    "discovery_quick_max_drawdown_pct": 48.0
  },
  "portfolio": {
    "portfolio_enabled": true,
    "portfolio_top_k": 3,
    "portfolio_min_candidates": 2,
    "portfolio_correlation_threshold": 0.80,
    "portfolio_max_weight": 0.55
  },
  "strategy_profile": {
    "max_strategy_timeframe": "1h",
    "allowed_informative_timeframes": ["15m", "1h"],
    "roi_target_min_pct": 1.5,
    "roi_target_max_pct": 6.0,
    "stoploss_min_pct": 2.0,
    "stoploss_max_pct": 5.5,
    "preferred_patterns": [
      "higher-beta futures breakout with 1h market state filter",
      "cross-sectional relative strength inside L1 L2 perp basket",
      "volatility expansion with aggressive profit capture but controlled drawdown",
      "RL or DL candidates that learn regime-dependent exposure, not constant churn"
    ],
    "avoid_patterns": [
      "fee-heavy overtrading under leverage",
      "tiny stoploss that dies in noise",
      "BTC clone strategies with no adaptation to beta or regime"
    ]
  }
}
