{
    "feature":  {
                    "args":  [
                                 "--config",
                                 "user_data/config_freqai.json",
                                 "--output",
                                 "user_data/freqai_features_real.json"
                             ],
                    "script":  "scripts/freqai_feature_agent.py"
                },
    "expression":  {
                       "args":  [
                                    "--config",
                                    "user_data/config_freqai.json",
                                    "--output",
                                    "user_data/freqai_expressions_selected.json",
                                    "--timeframe",
                                    "1h",
                                    "--mine",
                                     "--top-n",
                                     "30",
                                     "--llm-enabled",
                                     "--llm-count",
                                     "20",
                                     "--llm-retries",
                                     "3",
                                    "--llm-timeout",
                                    "60",
                                    "--llm-fallback"
                                ],
                       "feedback_top":  8,
                       "script":  "scripts/freqai_expression_agent.py"
                   },
    "ml_training":  {
                        "configs":  [
                                        {
                                            "data":  {
                                                         "feature_file":  "user_data/freqai_features_real.json",
                                                         "expressions_file":  "user_data/freqai_expressions_selected.json",
                                                         "data_dir":  "user_data/data",
                                                         "exchange":  "bitfinex",
                                                         "pairs":  [
                                                                       "BTC/USDT",
                                                                       "ETH/USDT"
                                                                   ],
                                                         "timeframe":  "1h",
                                                         "label_period":  12
                                                     },
                                            "model":  {
                                                          "name":  "lightgbm",
                                                          "params":  {
                                                                         "objective":  "regression",
                                                                         "metric":  "rmse",
                                                                         "learning_rate":  0.045,
                                                                         "num_leaves":  63,
                                                                         "subsample":  0.85,
                                                                         "feature_fraction":  0.85,
                                                                         "num_boost_round":  220,
                                                                         "model_dir":  "artifacts/models/lightgbm_real"
                                                                     }
                                                      },
                                            "training":  {
                                                             "validation_ratio":  0.2
                                                         },
                                            "output":  {
                                                           "model_dir":  "artifacts/models/lightgbm_real"
                                                       }
                                        }
                                    ]
                    },
    "rl_training":  {
                        "config":  {
                                       "data":  {
                                                    "feature_file":  "user_data/freqai_features_real.json",
                                                    "data_dir":  "user_data/data",
                                                    "exchange":  "bitfinex",
                                                    "pairs":  [
                                                                  "BTC/USDT"
                                                              ],
                                                    "timeframe":  "1h",
                                                    "label_period":  12
                                                },
                                       "policy":  "MlpPolicy",
                                       "algo":  {
                                                    "learning_rate":  0.0003,
                                                    "gamma":  0.99
                                                },
                                       "training":  {
                                                        "total_timesteps":  10000
                                                    },
                                       "output":  {
                                                      "model_dir":  "artifacts/models/rl_real"
                                                  }
                                   }
                    },
    "backtest":  {
                     "command":  [
                                     "./.venv/bin/freqtrade",
                                     "backtesting",
                                     "--userdir",
                                     "user_data",
                                     "--config",
                                     "user_data/config_freqai.json",
                                     "--strategy",
                                     "ExpressionLongStrategy",
                                     "--strategy-path",
                                     "user_data/strategies",
                                     "--timerange",
                                     "20251126-20260125",
                                     "--cache",
                                     "none"
                                 ],
                     "results_dir":  "user_data/backtest_results"
                 }
}
