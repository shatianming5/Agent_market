{
  "budget": {
    "provider": "openai_compatible",
    "model": "gpt-5.2",
    "base_url": "http://127.0.0.1:4141/v1",
    "multiagent_enabled": true,
    "multiagent_refine_rounds": 1,
    "candidates_per_iteration": 6,
    "max_iterations": 200,
    "max_turns": 30,
    "max_retries": 3,
    "stale_timeout": 180.0,
    "repair_attempts": 5,
    "max_parallel_candidates": 6,
    "max_parallel_roles": 1
  },
  "backtest": {
    "freqtrade_config": "user_data/config_freqai_gate_spot_l1l2_alpha.json",
    "timerange": "20260314-20260329",
    "selection_timerange": "20260314-20260329",
    "holdout_timerange": "20260330-20260403",
    "train_timerange": "20260303-20260313",
    "backtest_timeout": 420,
    "enable_quick_funnel": true,
    "quick_backtest_pairs": ["ADA/USDT", "AVAX/USDT", "ARB/USDT"],
    "quick_backtest_timeout": 120,
    "max_strategy_timeframe": "1h",
    "allowed_informative_timeframes": ["15m", "1h"]
  },
  "model_mining": {
    "candidate_types": ["rule", "ml", "dl", "rl"],
    "enable_dl": true,
    "enable_rl": true,
    "train_timerange": "20260303-20260313",
    "model_training_pairs": [
      "ADA/USDT",
      "AVAX/USDT",
      "DOT/USDT",
      "LINK/USDT",
      "NEAR/USDT",
      "ARB/USDT",
      "OP/USDT",
      "SUI/USDT",
      "APT/USDT"
    ],
    "rl_total_timesteps": 20000
  },
  "search_space": {
    "search_families": [
      "rule/trend-following",
      "rule/breakout",
      "rule/pair-relative",
      "rule/mean-reversion",
      "ml/lightgbm",
      "ml/xgboost",
      "dl/pytorch_mlp",
      "rl/ppo"
    ]
  },
  "tools": {
    "tool_allowlist": ["file", "bash"],
    "bash_allow": true,
    "bash_timeout": 60,
    "bash_allowlist": [
      "ls ",
      "find ",
      "cat ",
      "head ",
      "tail ",
      "sed ",
      "grep ",
      "python ",
      "python3 ",
      "freqtrade "
    ]
  },
  "evaluation": {
    "min_trades": 8,
    "max_abs_drawdown": 80.0,
    "max_drawdown_pct": 22.0,
    "min_winrate": 0.40,
    "min_profit_factor": 1.0,
    "min_profit_pct": 0.0,
    "min_positive_days_ratio": 0.42,
    "min_return_over_drawdown": 0.30,
    "min_pair_profit_pct": -3.0,
    "target_trades": 120,
    "min_acceptable_trades": 40,
    "objective_weights": {
      "sharpe": 0.16,
      "sortino": 0.10,
      "profit_factor": 0.15,
      "calmar": 0.05,
      "profit_pct": 0.29,
      "winrate": 0.05,
      "return_over_drawdown": 0.20
    },
    "hyperopt_enabled": true,
    "hyperopt_epochs": 80,
    "hyperopt_spaces": ["buy", "sell", "roi", "stoploss"],
    "hyperopt_loss": "SharpeHyperOptLoss",
    "hyperopt_jobs": 12,
    "hyperopt_min_trades": 10,
    "walkforward_enabled": true,
    "walkforward_folds": 4,
    "walkforward_train_ratio": 0.6,
    "benchmark_suite": "benchmark_pack/default"
  },
  "portfolio": {
    "portfolio_enabled": true,
    "portfolio_top_k": 3,
    "portfolio_min_candidates": 2,
    "portfolio_correlation_threshold": 0.80,
    "portfolio_max_weight": 0.55
  },
  "strategy_profile": {
    "max_strategy_timeframe": "1h",
    "allowed_informative_timeframes": ["15m", "1h"],
    "roi_target_min_pct": 1.0,
    "roi_target_max_pct": 4.0,
    "stoploss_min_pct": 1.0,
    "stoploss_max_pct": 4.0,
    "preferred_patterns": [
      "cross-sectional rotation inside L1 L2 basket",
      "5m breakout or trend-following with 1h market regime filter",
      "pair-relative strength between beta names such as ARB OP SUI APT",
      "volatility expansion with fast invalidation, not passive averaging down"
    ],
    "avoid_patterns": [
      "copying BTC style setups without adapting to higher beta behavior",
      "slow swing logic that ignores intraday regime shifts",
      "hyperactive churn that pays fees without harvesting real moves"
    ]
  }
}
