{
  "budget": {
    "provider": "openai_compatible",
    "model": "gpt-5.2",
    "base_url": null,
    "multiagent_enabled": false,
    "multiagent_refine_rounds": 0,
    "candidates_per_iteration": 1,
    "max_iterations": 20,
    "max_turns": 24,
    "max_retries": 3,
    "stale_timeout": 180.0,
    "repair_attempts": 4,
    "max_parallel_candidates": 1,
    "max_parallel_roles": 1
  },
  "backtest": {
    "freqtrade_config": "user_data/config_freqai_gate_5m.json",
    "timerange": "20260301-20260329",
    "backtest_timeout": 420,
    "max_strategy_timeframe": "15m",
    "allowed_informative_timeframes": [
      "15m"
    ]
  },
  "model_mining": {
    "candidate_types": [
      "ml",
      "dl",
      "rl"
    ],
    "model_feature_file": "user_data/freqai_features_real.json",
    "model_expressions_file": "user_data/freqai_expressions_selected.json",
    "model_training_pairs": [
      "AVAX/USDT",
      "BTC/USDT",
      "DOGE/USDT",
      "ETH/USDT",
      "SOL/USDT",
      "XRP/USDT"
    ],
    "model_output_root": "artifacts/models/strategy_miner_smoke",
    "training_validation_ratio": 0.2,
    "training_rolling_splits": 3,
    "training_scaler": "robust",
    "rl_total_timesteps": 2500
  },
  "tools": {
    "tool_allowlist": [
      "file",
      "bash"
    ],
    "bash_allow": true,
    "bash_timeout": 60,
    "bash_allowlist": [
      "ls ",
      "find ",
      "cat ",
      "head ",
      "tail ",
      "sed ",
      "grep ",
      "python ",
      "python3 ",
      "freqtrade "
    ]
  },
  "evaluation": {
    "min_trades": 150,
    "max_abs_drawdown": 80.0,
    "max_drawdown_pct": 20.0,
    "min_winrate": 0.55,
    "min_profit_factor": 1.15,
    "min_profit_pct": 2.0,
    "min_positive_days_ratio": 0.55,
    "min_return_over_drawdown": 1.25,
    "min_pair_profit_pct": -1.0,
    "target_trades": 300,
    "min_acceptable_trades": 100
  },
  "strategy_profile": {
    "roi_target_min_pct": 0.3,
    "roi_target_max_pct": 1.0,
    "stoploss_min_pct": 0.8,
    "stoploss_max_pct": 1.5,
    "preferred_patterns": [
      "5m VWAP/Bollinger/CCI/Williams %R mean-reversion with explicit fee awareness",
      "5m entries with 15m trend or volatility regime filter for pullback continuation",
      "5m Donchian retest breakout or opening-range breakout with time-based exits",
      "intraday classification/regression signals that target 200-600 trades over one month across six pairs"
    ],
    "avoid_patterns": [
      "1h swing breakout strategies",
      "slow EMA-only trend followers with multi-day holding assumptions",
      "strategies that ignore fee drag, holding cost, or max-hold logic"
    ]
  }
}
