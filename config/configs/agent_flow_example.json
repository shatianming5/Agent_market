{
    "feature": {
        "args": [
            "--config",
            "user_data/config_freqai.json",
            "--output",
            "user_data/freqai_features_real.json"
        ],
        "cwd": "freqtrade",
        "script": "scripts/freqai_feature_agent.py",
        "runtime": {
            "retry": {
                "attempts": 2,
                "delay": 5
            },
            "rate_limit": {
                "interval": 1.0
            }
        }
    },
    "expression": {
        "args": [
            "--config",
            "user_data/config_freqai.json",
            "--output",
            "user_data/freqai_expressions.json",
            "--timeframe",
            "1h",
            "--llm-enabled",
            "--llm-base-url",
            "https://api.zhizengzeng.com/v1",
            "--llm-model",
            "glm-4-air",
            "--llm-count",
            "20",
            "--llm-retries",
            "3",
            "--llm-timeout",
            "60",
            "--llm-fallback"
        ],
        "feedback_top": 8,
        "cwd": "freqtrade",
        "script": "scripts/freqai_expression_agent.py",
        "runtime": {
            "timeout": 900
        }
    },
    "ml_training": {
        "configs": [
            {
                "data": {
                    "feature_file": "resources/user_data/freqai_features_real.json",
                    "data_dir": "resources/user_data/data",
                    "exchange": "binanceus",
                    "pairs": [
                        "BTC/USDT",
                        "ETH/USDT"
                    ],
                    "timeframe": "1h",
                    "label_period": 12
                },
                "model": {
                    "name": "lightgbm",
                    "params": {
                        "objective": "regression",
                        "metric": "rmse",
                        "learning_rate": 0.045,
                        "num_leaves": 63,
                        "subsample": 0.85,
                        "feature_fraction": 0.85,
                        "num_boost_round": 220,
                        "model_dir": "artifacts/models/lightgbm_real"
                    }
                },
                "training": {
                    "validation_ratio": 0.2
                },
                "output": {
                    "model_dir": "artifacts/models/lightgbm_real"
                }
            },
            {
                "data": {
                    "feature_file": "resources/user_data/freqai_features_real.json",
                    "data_dir": "resources/user_data/data",
                    "exchange": "binanceus",
                    "pairs": [
                        "BTC/USDT",
                        "ETH/USDT"
                    ],
                    "timeframe": "1h",
                    "label_period": 12
                },
                "model": {
                    "name": "pytorch_mlp",
                    "params": {
                        "hidden_dims": [
                            256,
                            128,
                            64
                        ],
                        "dropout": 0.1,
                        "epochs": 30,
                        "batch_size": 128,
                        "learning_rate": 0.0007,
                        "model_dir": "artifacts/models/pytorch_real",
                        "use_cuda": false
                    }
                },
                "training": {
                    "validation_ratio": 0.2
                },
                "output": {
                    "model_dir": "artifacts/models/pytorch_real"
                }
            }
        ],
        "runtime": {
            "concurrency": 2,
            "retry": {
                "attempts": 2,
                "delay": 10,
                "max_delay": 60
            },
            "fail_fast": true
        }
    },
    "rl_training": {
        "config": {
            "data": {
                "feature_file": "resources/user_data/freqai_features_real.json",
                "data_dir": "resources/user_data/data",
                "exchange": "binanceus",
                "pairs": [
                    "BTC/USDT"
                ],
                "timeframe": "1h",
                "label_period": 12
            },
            "policy": "MlpPolicy",
            "algo": {
                "learning_rate": 0.0003,
                "gamma": 0.99
            },
            "training": {
                "total_timesteps": 10000
            },
            "output": {
                "model_dir": "artifacts/models/rl_real"
            }
        },
        "runtime": {
            "retry": {
                "attempts": 3,
                "delay": 15
            }
        }
    },
    "backtest": {
        "command": [
            "freqtrade",
            "backtesting",
            "--config",
            "resources/user_data/config_freqai.json",
            "--strategy",
            "ExpressionLongStrategy",
            "--strategy-path",
            "resources/user_data/strategies",
            "--timerange",
            "20210101-20210131",
            "--freqaimodel",
            "LightGBMRegressor"
        ],
        "results_dir": "resources/user_data/backtest_results",
        "runtime": {
            "timeout": 1800,
            "retry": {
                "attempts": 2,
                "delay": 30
            }
        }
    }
}