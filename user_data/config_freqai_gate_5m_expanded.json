{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "trading_mode": "spot",
  "dry_run": true,
  "max_open_trades": 10,
  "stake_currency": "USDT",
  "stake_amount": 50,
  "tradable_balance_ratio": 1,
  "fiat_display_currency": "USD",
  "timeframe": "5m",
  "dry_run_wallet": 1000,
  "fee": 0.001,
  "cancel_open_orders_on_exit": true,
  "unfilledtimeout": {
    "entry": 5,
    "exit": 5
  },
  "exchange": {
    "name": "gate",
    "key": "",
    "secret": "",
    "pair_whitelist": [
      "AVAX/USDT",
      "BTC/USDT",
      "DOGE/USDT",
      "ETH/USDT",
      "SOL/USDT",
      "XRP/USDT",
      "ADA/USDT",
      "DOT/USDT",
      "LINK/USDT",
      "NEAR/USDT",
      "ARB/USDT",
      "OP/USDT",
      "SUI/USDT",
      "APT/USDT"
    ],
    "pair_blacklist": [],
    "ccxt_config": {
      "timeout": 60000
    }
  },
  "pairlists": [
    {
      "method": "StaticPairList",
      "allow_inactive": true
    }
  ],
  "freqai": {
    "enabled": false,
    "purge_old_models": 2,
    "train_period_days": 45,
    "backtest_period_days": 15,
    "live_retrain_hours": 0,
    "identifier": "freqai-gate-5m-expanded",
    "feature_parameters": {
      "include_timeframes": [
        "5m",
        "15m"
      ],
      "include_corr_pairlist": [
        "BTC/USDT",
        "ETH/USDT"
      ],
      "label_period_candles": 12,
      "include_shifted_candles": 2,
      "DI_threshold": 0.9,
      "weight_factor": 0.85,
      "principal_component_analysis": false,
      "use_SVM_to_remove_outliers": false,
      "indicator_periods_candles": [
        12,
        24,
        48
      ],
      "plot_feature_importances": 0
    },
    "data_split_parameters": {
      "test_size": 0.3,
      "random_state": 7
    },
    "model_training_parameters": {}
  },
  "datadir": "user_data/data",
  "dataformat_ohlcv": "feather",
  "bot_name": "freqai-gate-5m-expanded",
  "force_entry_enable": true,
  "initial_state": "running",
  "internals": {
    "process_throttle_secs": 5
  },
  "entry_pricing": {
    "price_side": "other",
    "use_order_book": false,
    "order_book_top": 1
  },
  "exit_pricing": {
    "price_side": "other",
    "use_order_book": false,
    "order_book_top": 1
  }
}
